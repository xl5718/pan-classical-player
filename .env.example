# 百度网盘开放平台应用凭证（https://pan.baidu.com/union/console）
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=

# 网盘中曲库根目录（绝对路径，以 / 开头）
MUSIC_ROOT=/音乐

# 本地数据目录：token、SQLite、封面、音频缓存
DATA_DIR=./data

# 音频缓存上限（GB）
CACHE_MAX_GB=5

# 后端监听
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

LOG_LEVEL=INFO

# 扫描并发：目录列表请求数 / 同时读取文件头的数量
LIST_CONCURRENCY=4
SCAN_CONCURRENCY=8

# 播放时下载当前曲目所用的并发连接数 / 预取下一首的连接数
PLAY_CONNECTIONS=3
PREFETCH_CONNECTIONS=2
